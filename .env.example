# Port the app is exposed on the host
PORT=3000

# Set to "true" to require a password login (e.g. when exposed via nginx/Cloudflare).
# Leave unset/"false" for trusted LAN-only use.
AUTH_ENABLED=false

# Required when AUTH_ENABLED=true: a bcrypt hash of the login password.
# Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
AUTH_PASSWORD_HASH=

# Secret used to sign the auth session cookie. Set to a long random string in production.
SESSION_SECRET=change-me-in-production

# Set to "true" only if this process itself terminates HTTPS directly (rare — most
# setups put nginx/Cloudflare in front doing TLS termination, in which case leave
# this false/unset, since the app receives plain HTTP from the proxy).
COOKIE_SECURE=false
