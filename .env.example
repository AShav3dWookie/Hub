# Port the app is exposed on the host
PORT=3000

# Set to "true" to require a password login (e.g. when exposed via nginx/Cloudflare).
# Leave unset/"false" for trusted LAN-only use. See docs/wan-security.md.
AUTH_ENABLED=false

# Required when AUTH_ENABLED=true: a bcrypt hash of the login password.
# Generate one with:  npm run auth:hash -- 'your password'
# In docker-compose files, double every "$" ($$) so Compose doesn't interpolate it.
#
# This is the FIRST-RUN value only. Once the password is changed — in the app under
# Settings -> Password, or with `npm run auth:set-password` — the value stored in the
# database wins and this one is ignored. Keep a valid hash here anyway: the server still
# refuses to start without it. See docs/wan-security.md.
AUTH_PASSWORD_HASH=

# Secret used to sign the auth session cookie. Required when AUTH_ENABLED=true:
# the server refuses to start on a known placeholder or anything under 32 chars.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-me-in-production

# How Express treats X-Forwarded-* headers. Set to "1" when behind one reverse
# proxy (nginx/Cloudflare) so X-Forwarded-Proto is honoured and the session
# cookie is correctly marked Secure. Auto-defaults to "1" when AUTH_ENABLED=true.
TRUST_PROXY=

# Whether to mark the session cookie "Secure". LEAVE UNSET — it is then derived
# per request from the (proxy-aware) scheme, which is correct for both plain-HTTP
# LAN use and HTTPS-via-proxy. Forcing "true" on a request seen as plain HTTP
# makes the cookie silently vanish. Only set "true" if this process itself does TLS.
COOKIE_SECURE=

# Session cookie lifetime in days (default 90). The cookie is persistent and its
# expiry slides forward on activity, so this is "log in again after being away
# this long", not "log in again every N days".
SESSION_MAX_AGE_DAYS=
