# The repo-root .env: settings for working on this repo, on your own PC.
#   cp .env.example .env
#
# Two things read it:
#   1. The dev container — `docker compose up` here (docker-compose.yml) fills its settings in
#      from this file.
#   2. The repo's own scripts — the companion:* scripts, `npm run hub:logs` and
#      `npm run voice:check`. They parse this file; they never `source` it.
#
# Nothing here reaches the home server. That has its own .env, from deploy/.env.example.
# Every hub setting is explained in docs/configuration.md. Compose reads this file, so write
# any "$" as "$$" (bcrypt hashes are full of them).

# --- 1. The dev container (docker-compose.yml) ---------------------------------------------

# Host port for http://localhost:<PORT>.
# PORT=3000

# Password login. Off is fine on your own PC. Turning it on needs a real SESSION_SECRET
# (32+ chars) and a hash from `npm run auth:hash -- 'pw'`, with every $ doubled.
# AUTH_ENABLED=false
# AUTH_PASSWORD_HASH=
# SESSION_SECRET=
# TRUST_PROXY=
# COOKIE_SECURE=
# SESSION_MAX_AGE_DAYS=

# Voice. Without a key every voice command is refused. `npm run voice:check` uses the same key.
# ANTHROPIC_API_KEY=
# VOICE_MODEL=

# --- 2. Scripts --------------------------------------------------------------------------

# Reading the hub's log from this PC: `npm run hub:logs` (docs/logs.md).
# HUB_LOGS_TOKEN comes from Settings → Devices → "Logs only: read from a PC".
# HUB_URL=https://hub.aaronhanna.uk
# HUB_LOGS_TOKEN=

# The Android companion app (companion-app/README.md lists what each one is for).
# Release signing: keygen, install, build, secrets.
# COMPANION_KEYSTORE=~/.hub-companion/release.jks
# COMPANION_KEYSTORE_PASSWORD=
# COMPANION_KEY_ALIAS=hub-companion
# COMPANION_KEY_PASSWORD=
# The hub address as the phone sees it: pair, arrive, leave.
# COMPANION_HUB_URL=http://192.168.1.4:3000
# COMPANION_HUB_PASSWORD=
# COMPANION_DEVICE_NAME=
# Wireless debugging instead of USB: install, pair, arrive, leave.
# COMPANION_ADB_DEVICE=
# COMPANION_ADB_PAIR=
# COMPANION_ADB_PAIR_CODE=
# COMPANION_ARRIVE_SECONDS=
