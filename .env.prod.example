# Production .env for the home server — copy to `.env` alongside docker-compose.prod.yml.
# See docs/deployment.md. For local development use .env.example instead.

# Which published image to run. Pin it explicitly rather than leaving it on `latest`, so you
# always know what is deployed and a rollback is just editing this line and re-running
# `docker compose -f docker-compose.prod.yml pull && ... up -d`.
IMAGE_TAG=1.0.0

# Host port. Published on all interfaces; host nginx proxies to 127.0.0.1:8090
# (see docker/nginx.prod.conf). Check it is free first: ss -ltnp | grep ':8090'
HOST_PORT=8090

# Leave on. The published port above bypasses nginx and Authelia, so the app's own password is
# the only thing guarding that path.
AUTH_ENABLED=true

# bcrypt hash of the login password. ⚠️ EVERY "$" MUST BE DOUBLED TO "$$".
#
# Compose interpolates this file, so a raw hash like $2b$12$iZOtv... has "$iZOtv..." eaten as an
# undefined variable and the salt is silently destroyed — the app starts fine and every login
# just fails. Generate the escaped form directly:
#
#   npm run auth:hash -- 'your password' | sed 's/\$/$$/g'
#
# Verify after filling it in — this must print the hash with SINGLE dollars:
#   docker compose -f docker-compose.prod.yml up -d
#   docker exec hub-app-1 printenv AUTH_PASSWORD_HASH
#
# This is the first-run value only: once the password is changed in Settings, or with
# `docker compose exec app node dist/scripts/setPassword.js`, the database value wins. Keep a
# valid hash here regardless — the server refuses to start without one.
AUTH_PASSWORD_HASH=

# Signing secret for the session cookie: openssl rand -base64 48
# The server refuses to start on a placeholder or anything under 32 characters.
SESSION_SECRET=

# One reverse proxy in front (nginx), so X-Forwarded-Proto is honoured and the session cookie
# is correctly marked Secure.
TRUST_PROXY=1

# Leave unset — derived per request from the proxy-aware scheme. See .env.example.
COOKIE_SECURE=

# Session lifetime in days (default 90).
SESSION_MAX_AGE_DAYS=
